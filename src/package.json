{
  "name": "veyra",
  "private": true,
  "version": "1.1.2",
  "description": "Veyra — next-gen proxy client powered by mihomo",
  "author": "Veyra",
  "productName": "Veyra",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "download-core": "node scripts/download-mihomo.mjs",
    "download-singbox": "node scripts/download-singbox.mjs",
    "build-icons": "node scripts/build-icons.mjs",
    "postinstall": "node scripts/download-mihomo.mjs",
    "start": "electron .",
    "dist": "npm run build-icons && npm run download-core && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:dir": "npm run build-icons && npm run download-core && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --dir"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "adm-zip": "^0.6.1",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.544.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "wait-on": "^8.0.5"
  }
}
