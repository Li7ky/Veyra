{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veyra-omini",
  "version": "1.1.9-beta.6",
  "identifier": "com.veyra.omini.devtest",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Veyra-omini",
        "width": 1080,
        "height": 680,
        "minWidth": 1080,
        "minHeight": 680,
        "maxWidth": 1080,
        "maxHeight": 680,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "visible": true,
        "dataDirectory": "WebView2Data",
        "backgroundColor": "#f3f5f8"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/bin/mihomo.exe": "bin/mihomo.exe",
      "../resources/config/default.yaml": "config/default.yaml",
      "../resources/icons": "icons",
      "../resources/licenses": "licenses"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
