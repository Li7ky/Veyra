/* ============================================================
   Veyra · Futuristic Dashboard
   设计语言：NEXUS OS — 深空黑 + 青色霓虹 + 粒子背景
   参考：futuristic-dashboard (v0 / shadcn / Tailwind)
   ============================================================ */

/* ── Design Tokens ───────────────────────────────────────── */
:root {
  --bg-0: #020617;
  --bg-1: #0f172a;
  --card: rgba(15, 23, 42, 0.50);
  --card-border: rgba(51, 65, 85, 0.50);
  --card-solid: #0f172a;
  --input-bg: rgba(30, 41, 59, 0.50);
  --input-border: rgba(51, 65, 85, 0.50);

  --text-100: #f1f5f9;
  --text-200: #e2e8f0;
  --text-300: #cbd5e1;
  --text-400: #94a3b8;
  --text-500: #64748b;
  --text-600: #475569;

  --cyan-400: #22d3ee;
  --cyan-500: #06b6d4;
  --blue-400: #60a5fa;
  --blue-500: #3b82f6;
  --blue-600: #2563eb;
  --purple-400: #c084fc;
  --purple-500: #a855f7;
  --green-400: #4ade80;
  --green-500: #22c55e;
  --emerald-500: #10b981;
  --amber-400: #fbbf24;
  --amber-500: #f59e0b;
  --red-400: #f87171;
  --red-500: #ef4444;
  --pink-500: #ec4899;
  --indigo-500: #6366f1;

  --accent: var(--cyan-500);
  --accent-hover: var(--cyan-400);
  --ok: var(--green-400);
  --warn: var(--amber-400);
  --bad: var(--red-400);

  --grad-cyan: linear-gradient(to right, var(--cyan-500), var(--blue-500));
  --grad-purple: linear-gradient(to right, var(--purple-500), var(--pink-500));
  --grad-blue: linear-gradient(to right, var(--blue-500), var(--indigo-500));
  --grad-green: linear-gradient(to right, var(--green-500), var(--emerald-500));
  --grad-text: linear-gradient(to right, var(--cyan-400), var(--blue-500));

  --font-sans: "Geist", "Inter", "Noto Sans SC", "Microsoft YaHei UI", "PingFang SC", sans-serif;
  --font-mono: "Geist Mono", "JetBrains Mono", "SFMono-Regular", Consolas, "Microsoft YaHei UI", monospace;

  --radius: 0.5rem;
  --radius-lg: 0.75rem;
  --radius-md: 0.5rem;
  --radius-sm: 0.25rem;
  --radius-full: 9999px;

  --ease: cubic-bezier(0.4, 0, 0.2, 1);
  --blur-sm: blur(4px);
  --blur: blur(8px);
}

/* ── Base Reset ──────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body, #root { height: 100%; overflow: hidden; }
body {
  font-family: var(--font-sans);
  font-size: 14px;
  line-height: 1.5;
  color: var(--text-100);
  background: var(--bg-0);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
img { max-width: 100%; display: block; }
button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
input, select, textarea { font-family: inherit; color: inherit; }
code, pre { font-family: var(--font-mono); }
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--text-600); border-radius: var(--radius-full); }
::-webkit-scrollbar-thumb:hover { background: var(--text-500); }

/* ── App Shell ───────────────────────────────────────────── */
.app {
  height: 100vh; max-width: none;
  background: linear-gradient(to bottom right, var(--bg-0), var(--bg-1));
  color: var(--text-100);
  position: relative;
  overflow: hidden;
}
.app::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(6, 182, 212, 0.06) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(99, 102, 241, 0.05) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 80%, rgba(168, 85, 247, 0.04) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
}
.app > * { position: relative; z-index: 1; }

/* ── Particle Canvas ─────────────────────────────────────── */
.particle-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.30;
  pointer-events: none;
  z-index: 0;
}

/* ── Loading Overlay ─────────────────────────────────────── */
.loading-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.80);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}
.loading-spinner {
  position: relative;
  width: 96px;
  height: 96px;
}
.loading-spinner > div {
  position: absolute;
  border-radius: 50%;
  border: 4px solid transparent;
}
.loading-spinner .ring1 {
  inset: 0;
  border-top-color: var(--cyan-500);
  animation: spin 1s linear infinite;
}
.loading-spinner .ring2 {
  inset: 8px;
  border-right-color: var(--purple-500);
  animation: spin-slow 3s linear infinite;
}
.loading-spinner .ring3 {
  inset: 16px;
  border-bottom-color: var(--blue-500);
  animation: spin-slower 6s linear infinite reverse;
}
.loading-spinner .ring4 {
  inset: 24px;
  border-left-color: var(--green-500);
  animation: spin 1s linear infinite;
}
.loading-text {
  margin-top: 16px;
  color: var(--cyan-500);
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 0.15em;
  text-align: center;
}

/* ── Layout Container ────────────────────────────────────── */
.container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 16px;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
}

/* ── Header ──────────────────────────────────────────────── */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 16px 0;
  border-bottom: 1px solid rgba(51, 65, 85, 0.50);
  margin-bottom: 24px;
}
.header-brand {
  display: flex;
  align-items: center;
  gap: 8px;
}
.header-brand svg { width: 32px; height: 32px; color: var(--cyan-500); }
.header-brand .brand-text {
  font-size: 20px;
  font-weight: 700;
  background: var(--grad-text);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.header-actions {
  display: flex;
  align-items: center;
  gap: 24px;
}
.header-search {
  display: flex;
  align-items: center;
  gap: 4px;
  background: rgba(30, 41, 59, 0.50);
  border: 1px solid rgba(51, 65, 85, 0.50);
  border-radius: var(--radius-full);
  padding: 6px 12px;
  backdrop-filter: var(--blur-sm);
  -webkit-backdrop-filter: var(--blur-sm);
}
.header-search svg { width: 16px; height: 16px; color: var(--text-400); flex-shrink: 0; }
.header-search input {
  background: transparent;
  border: none;
  outline: none;
  font-size: 13px;
  width: 160px;
  color: var(--text-100);
}
.header-search input::placeholder { color: var(--text-500); }
.header-icons {
  display: flex;
  align-items: center;
  gap: 12px;
}
.icon-btn {
  position: relative;
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: var(--radius-md);
  color: var(--text-400);
  transition: color 0.2s, background 0.2s;
}
.icon-btn:hover { color: var(--text-100); background: rgba(30, 41, 59, 0.50); }
.icon-btn svg { width: 20px; height: 20px; }
.icon-btn .dot {
  position: absolute;
  top: -4px;
  right: -4px;
  width: 8px;
  height: 8px;
  background: var(--cyan-500);
  border-radius: 50%;
  animation: pulse 2s infinite;
}
.avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--text-600);
  display: grid;
  place-items: center;
  font-size: 12px;
  font-weight: 600;
  color: var(--cyan-500);
  flex-shrink: 0;
}

/* ── 12-Column Grid ──────────────────────────────────────── */
.grid-12 {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 24px;
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
}
.col-sidebar { grid-column: span 2; min-height: 0; overflow-y: auto; overflow-x: hidden; }
.col-main { grid-column: span 7; min-height: 0; display: flex; flex-direction: column; overflow: hidden; }
.col-right { grid-column: span 3; min-height: 0; overflow-y: auto; overflow-x: hidden; }

/* ── Card ────────────────────────────────────────────────── */
.card {
  background: var(--card);
  border: 1px solid var(--card-border);
  border-radius: var(--radius-lg);
  backdrop-filter: var(--blur-sm);
  -webkit-backdrop-filter: var(--blur-sm);
  overflow: hidden;
}
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 24px 12px 24px;
  border-bottom: 1px solid rgba(51, 65, 85, 0.50);
}
.card-header.no-border { border-bottom: none; padding-bottom: 8px; }
.card-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-100);
}
.card-title svg { width: 20px; height: 20px; }
.card-title.text-base { font-size: 15px; }
.card-body { padding: 24px; }
.card-body.tight { padding: 16px; }
.card-body.p0 { padding: 0; }
.card-footer {
  display: flex;
  align-items: center;
  padding: 16px 24px;
  border-top: 1px solid rgba(51, 65, 85, 0.50);
}
.card-footer.flex { display: flex; align-items: center; }

/* ── Navigation (Sidebar) ────────────────────────────────── */
.nav-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.nav-item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 10px 12px;
  border-radius: var(--radius-md);
  font-size: 14px;
  color: var(--text-400);
  transition: all 0.2s var(--ease);
  text-align: left;
}
.nav-item:hover { color: var(--text-100); background: rgba(30, 41, 59, 0.50); }
.nav-item.active {
  background: rgba(30, 41, 59, 0.70);
  color: var(--cyan-400);
}
.nav-item svg { width: 16px; height: 16px; flex-shrink: 0; }
.nav-section-title {
  font-size: 11px;
  color: var(--text-500);
  font-family: var(--font-mono);
  margin-bottom: 8px;
  letter-spacing: 0.05em;
}

/* ── Status Item ─────────────────────────────────────────── */
.status-item { margin-bottom: 12px; }
.status-item:last-child { margin-bottom: 0; }
.status-item-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4px;
  font-size: 12px;
  color: var(--text-400);
}
.status-bar {
  height: 6px;
  background: rgba(30, 41, 59, 0.80);
  border-radius: var(--radius-full);
  overflow: hidden;
}
.status-bar > i {
  display: block;
  height: 100%;
  border-radius: var(--radius-full);
}
.status-bar > i.cyan { background: var(--grad-cyan); }
.status-bar > i.green { background: var(--grad-green); }
.status-bar > i.blue { background: var(--grad-blue); }
.status-bar > i.purple { background: var(--grad-purple); }

/* ── Badge ───────────────────────────────────────────────── */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 2px 8px;
  border-radius: var(--radius-md);
  font-size: 11px;
  font-weight: 500;
  white-space: nowrap;
  border: 1px solid transparent;
}
.badge-outline {
  background: rgba(30, 41, 59, 0.50);
  border-color: var(--card-border);
  color: var(--text-300);
}
.badge-cyan { background: rgba(6, 182, 212, 0.15); color: var(--cyan-400); border-color: rgba(6, 182, 212, 0.50); }
.badge-green { background: rgba(34, 197, 94, 0.15); color: var(--green-400); border-color: rgba(34, 197, 94, 0.50); }
.badge-blue { background: rgba(59, 130, 246, 0.15); color: var(--blue-400); border-color: rgba(59, 130, 246, 0.50); }
.badge-amber { background: rgba(245, 158, 11, 0.15); color: var(--amber-400); border-color: rgba(245, 158, 11, 0.50); }
.badge-red { background: rgba(239, 68, 68, 0.15); color: var(--red-400); border-color: rgba(239, 68, 68, 0.50); }
.badge-purple { background: rgba(168, 85, 247, 0.15); color: var(--purple-400); border-color: rgba(168, 85, 247, 0.50); }

/* ── Buttons ─────────────────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 36px;
  padding: 0 16px;
  border-radius: var(--radius-md);
  font-size: 14px;
  font-weight: 500;
  transition: all 0.2s var(--ease);
  white-space: nowrap;
}
.btn:disabled { opacity: 0.50; pointer-events: none; }
.btn svg { width: 16px; height: 16px; }
.btn-primary { background: var(--blue-600); color: #fff; }
.btn-primary:hover { background: var(--blue-500); }
.btn-cyan { background: var(--cyan-500); color: var(--bg-0); }
.btn-cyan:hover { background: var(--cyan-400); }
.btn-outline {
  background: rgba(30, 41, 59, 0.50);
  border: 1px solid var(--card-border);
  color: var(--text-200);
}
.btn-outline:hover { background: rgba(51, 65, 85, 0.50); }
.btn-ghost {
  background: transparent;
  color: var(--text-400);
}
.btn-ghost:hover { background: rgba(30, 41, 59, 0.50); color: var(--text-100); }
.btn-danger { background: var(--red-500); color: #fff; }
.btn-danger:hover { background: var(--red-400); }
.btn-sm { height: 28px; padding: 0 10px; font-size: 12px; border-radius: var(--radius-sm); }
.btn-sm svg { width: 14px; height: 14px; }
.btn-icon { width: 36px; height: 36px; padding: 0; }
.btn-icon.sm { width: 32px; height: 32px; }

/* ── Metric Card ─────────────────────────────────────────── */
.metric-card {
  background: rgba(30, 41, 59, 0.50);
  border-radius: var(--radius-lg);
  border: 1px solid var(--card-border);
  padding: 16px;
  position: relative;
  overflow: hidden;
}
.metric-card.cyan { border-color: rgba(6, 182, 212, 0.30); }
.metric-card.purple { border-color: rgba(168, 85, 247, 0.30); }
.metric-card.blue { border-color: rgba(59, 130, 246, 0.30); }
.metric-card.green { border-color: rgba(34, 197, 94, 0.30); }
.metric-card-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
  font-size: 13px;
  color: var(--text-400);
}
.metric-card-hd svg { width: 20px; height: 20px; }
.metric-card-hd svg.cyan { color: var(--cyan-500); }
.metric-card-hd svg.purple { color: var(--purple-500); }
.metric-card-hd svg.blue { color: var(--blue-500); }
.metric-card-val {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 4px;
  background: linear-gradient(to right, var(--text-100), var(--text-300));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.metric-card-detail { font-size: 12px; color: var(--text-500); }
.metric-card-glow {
  position: absolute;
  bottom: -24px;
  right: -24px;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  opacity: 0.20;
  filter: blur(24px);
  background: var(--grad-cyan);
}

/* ── Tabs ────────────────────────────────────────────────── */
.tabs-list {
  display: inline-flex;
  gap: 2px;
  padding: 4px;
  background: rgba(30, 41, 59, 0.50);
  border-radius: var(--radius-md);
}
.tabs-trigger {
  padding: 6px 14px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  color: var(--text-400);
  transition: all 0.2s;
}
.tabs-trigger:hover { color: var(--text-200); }
.tabs-trigger.active {
  background: rgba(51, 65, 85, 0.70);
  color: var(--cyan-400);
}
.tabs-content { margin-top: 0; }

/* ── Progress Bar ────────────────────────────────────────── */
.progress {
  height: 8px;
  background: rgba(30, 41, 59, 0.80);
  border-radius: var(--radius-full);
  overflow: hidden;
}
.progress.thin { height: 6px; }
.progress > i {
  display: block;
  height: 100%;
  border-radius: var(--radius-full);
  transition: width 0.3s var(--ease);
}
.progress > i.cyan { background: var(--grad-cyan); }
.progress > i.green { background: var(--grad-green); }
.progress > i.blue { background: var(--grad-blue); }
.progress > i.purple { background: var(--grad-purple); }
.progress > i.amber { background: linear-gradient(to right, var(--amber-500), var(--red-500)); }

/* ── Switch / Toggle ─────────────────────────────────────── */
.switch {
  position: relative;
  width: 40px;
  height: 22px;
  border-radius: var(--radius-full);
  background: var(--text-600);
  cursor: pointer;
  transition: background 0.2s;
}
.switch.on { background: var(--cyan-500); }
.switch::after {
  content: "";
  position: absolute;
  top: 3px;
  left: 3px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #fff;
  transition: transform 0.2s;
}
.switch.on::after { transform: translateX(18px); }

/* ── Input ───────────────────────────────────────────────── */
.input {
  width: 100%;
  height: 36px;
  padding: 0 12px;
  border: 1px solid var(--input-border);
  border-radius: var(--radius-md);
  background: var(--input-bg);
  color: var(--text-100);
  font-size: 14px;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.input:focus {
  border-color: var(--cyan-500);
  box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.25);
}
.input::placeholder { color: var(--text-500); }

/* ── Alert Item ──────────────────────────────────────────── */
.alert-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}
.alert-icon {
  margin-top: 2px;
  padding: 4px;
  border-radius: 50%;
  flex-shrink: 0;
}
.alert-icon svg { width: 12px; height: 12px; }
.alert-icon.info { background: rgba(59, 130, 246, 0.10); border: 1px solid rgba(59, 130, 246, 0.30); color: var(--blue-500); }
.alert-icon.warning { background: rgba(245, 158, 11, 0.10); border: 1px solid rgba(245, 158, 11, 0.30); color: var(--amber-500); }
.alert-icon.success { background: rgba(34, 197, 94, 0.10); border: 1px solid rgba(34, 197, 94, 0.30); color: var(--green-500); }
.alert-icon.update { background: rgba(6, 182, 212, 0.10); border: 1px solid rgba(6, 182, 212, 0.30); color: var(--cyan-500); }
.alert-title { font-size: 13px; font-weight: 500; color: var(--text-200); }
.alert-time { font-size: 11px; color: var(--text-500); margin-left: 8px; }
.alert-desc { font-size: 12px; color: var(--text-400); margin-top: 2px; }

/* ── Communication Item ──────────────────────────────────── */
.comm-item {
  display: flex;
  gap: 12px;
  padding: 8px;
  border-radius: var(--radius-md);
}
.comm-item.unread {
  background: rgba(30, 41, 59, 0.50);
  border: 1px solid rgba(51, 65, 85, 0.50);
}
.comm-item .avatar-sm {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--text-600);
  display: grid;
  place-items: center;
  font-size: 12px;
  color: var(--cyan-500);
  flex-shrink: 0;
}
.comm-body { flex: 1; min-width: 0; }
.comm-sender { font-size: 13px; font-weight: 500; color: var(--text-200); }
.comm-time { font-size: 11px; color: var(--text-500); }
.comm-msg { font-size: 12px; color: var(--text-400); margin-top: 4px; }
.comm-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--cyan-500);
  flex-shrink: 0;
  align-self: center;
}

/* ── Action Button Grid ──────────────────────────────────── */
.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 12px;
  border: 1px solid var(--card-border);
  border-radius: var(--radius-md);
  background: rgba(30, 41, 59, 0.50);
  color: var(--text-200);
  transition: all 0.2s;
}
.action-btn:hover { background: rgba(51, 65, 85, 0.50); }
.action-btn svg { width: 20px; height: 20px; color: var(--cyan-500); }
.action-btn span { font-size: 12px; }

/* ── Time Display ────────────────────────────────────────── */
.time-display {
  background: linear-gradient(to bottom right, rgba(30, 41, 59, 0.80), rgba(15, 23, 42, 0.80));
  padding: 24px;
  border-bottom: 1px solid rgba(51, 65, 85, 0.50);
  text-align: center;
}
.time-label {
  font-size: 11px;
  color: var(--text-500);
  font-family: var(--font-mono);
  margin-bottom: 4px;
  letter-spacing: 0.05em;
}
.time-value {
  font-size: 32px;
  font-family: var(--font-mono);
  color: var(--cyan-400);
  margin-bottom: 4px;
}
.time-date { font-size: 13px; color: var(--text-400); }

/* ── Storage Item ────────────────────────────────────────── */
.storage-item {
  background: rgba(30, 41, 59, 0.50);
  border: 1px solid rgba(51, 65, 85, 0.50);
  border-radius: var(--radius-md);
  padding: 12px;
}
.storage-item-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}
.storage-item-name { font-size: 13px; color: var(--text-300); }

/* ── Table ───────────────────────────────────────────────── */
.table-header {
  display: grid;
  gap: 0;
  padding: 12px;
  font-size: 12px;
  color: var(--text-400);
  border-bottom: 1px solid rgba(51, 65, 85, 0.50);
  background: rgba(30, 41, 59, 0.50);
}
.table-row {
  display: grid;
  gap: 0;
  padding: 8px 12px;
  font-size: 13px;
  transition: background 0.15s;
}
.table-row:hover { background: rgba(30, 41, 59, 0.50); }
.table-row + .table-row { border-top: 1px solid rgba(51, 65, 85, 0.30); }
.divide-y > * + * { border-top: 1px solid rgba(51, 65, 85, 0.30); }

/* ── Utility ─────────────────────────────────────────────── */
.text-center { text-align: center; }
.text-right { text-align: right; }
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.gap-1 { gap: 4px; }
.gap-2 { gap: 8px; }
.gap-3 { gap: 12px; }
.gap-4 { gap: 16px; }
.gap-6 { gap: 24px; }
.mt-1 { margin-top: 4px; }
.mt-2 { margin-top: 8px; }
.mt-3 { margin-top: 12px; }
.mt-4 { margin-top: 16px; }
.mt-6 { margin-top: 24px; }
.mt-8 { margin-top: 32px; }
.mb-1 { margin-bottom: 4px; }
.mb-2 { margin-bottom: 8px; }
.mb-3 { margin-bottom: 12px; }
.mb-4 { margin-bottom: 16px; }
.pt-2 { padding-top: 8px; }
.pt-4 { padding-top: 16px; }
.pt-6 { padding-top: 24px; }
.mr-2 { margin-right: 8px; }
.w-full { width: 100%; }
.font-mono { font-family: var(--font-mono); }
.font-bold { font-weight: 700; }
.font-semibold { font-weight: 600; }
.font-medium { font-weight: 500; }
.text-xs { font-size: 11px; }
.text-sm { font-size: 13px; }
.text-base { font-size: 14px; }
.text-lg { font-size: 16px; }
.text-xl { font-size: 20px; }
.text-2xl { font-size: 24px; }
.text-3xl { font-size: 30px; }
.text-muted { color: var(--text-400); }
.text-faint { color: var(--text-500); }
.text-cyan { color: var(--cyan-400); }
.text-green { color: var(--green-400); }
.text-blue { color: var(--blue-400); }
.text-purple { color: var(--purple-400); }
.text-amber { color: var(--amber-400); }
.text-red { color: var(--red-400); }
.border-t { border-top: 1px solid rgba(51, 65, 85, 0.50); }
.border-b { border-bottom: 1px solid rgba(51, 65, 85, 0.50); }
.rounded-lg { border-radius: var(--radius-lg); }
.rounded-md { border-radius: var(--radius-md); }
.overflow-hidden { overflow: hidden; }
.relative { position: relative; }
.hidden { display: none; }

/* ── Spacing helpers for grids ───────────────────────────── */
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; }
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
.grid-stack { display: grid; gap: 24px; }
.grid-stack-sm { display: grid; gap: 12px; }

/* ── Animations ──────────────────────────────────────────── */
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
@keyframes spin-slow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
@keyframes spin-slower {
  from { transform: rotate(0deg); }
  to { transform: rotate(-360deg); }
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
@keyframes ping {
  0% { transform: scale(1); opacity: 1; }
  75%, 100% { transform: scale(2); opacity: 0; }
}
.animate-spin { animation: spin 1s linear infinite; }
.animate-spin-slow { animation: spin-slow 3s linear infinite; }
.animate-spin-slower { animation: spin-slower 6s linear infinite; }
.animate-pulse { animation: pulse 2s infinite; }
.animate-ping { animation: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite; }

/* ── Responsive ──────────────────────────────────────────── */
@media (max-width: 1024px) {
  .col-sidebar { grid-column: span 3; }
  .col-main { grid-column: span 9; }
  .col-right { grid-column: span 12; }
}
@media (max-width: 768px) {
  .grid-12 { grid-template-columns: 1fr; }
  .col-sidebar, .col-main, .col-right { grid-column: span 1; }
  .grid-2, .grid-3 { grid-template-columns: 1fr; }
  .header { flex-direction: column; gap: 12px; }
  .header-search { display: none; }
}


/* ═══════════════════════════════════════════════════════════
   COMPONENT LAYER — Futuristic Dashboard
   ═══════════════════════════════════════════════════════════ */

/* ── Overview Strip ─────────────────────────────────────── */
.overview-strip {
  display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
  padding: 16px 20px;
  background: var(--card); border: 1px solid var(--card-border);
  border-radius: var(--radius-lg); backdrop-filter: var(--blur-sm);
}
.overview-status { display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1; }
.overview-pulse { width: 10px; height: 10px; border-radius: 50%; background: var(--text-500); flex-shrink: 0; }
.overview-pulse.on { background: var(--cyan-500); box-shadow: 0 0 10px var(--cyan-500); animation: pulse 2s infinite; }
.overview-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; color: var(--text-500); text-transform: uppercase; display: block; }
.overview-status strong { display: block; font-size: 16px; font-weight: 700; color: var(--text-100); }
.overview-status small { display: block; font-size: 11px; color: var(--text-400); margin-top: 2px; font-family: var(--font-mono); }
.overview-metrics { display: flex; align-items: center; gap: 0; overflow-x: auto; }
.overview-metrics > div { padding: 0 16px; border-left: 1px solid rgba(51,65,85,0.50); min-width: 0; }
.overview-metrics > div:first-child { border-left: 0; padding-left: 0; }
.overview-metrics span { display: block; font-size: 10px; color: var(--text-500); font-weight: 700; letter-spacing: 0.05em; }
.overview-metrics b { display: block; margin-top: 2px; font-size: 14px; font-weight: 800; font-family: var(--font-mono); color: var(--text-100); white-space: nowrap; }
.overview-action {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 8px 16px; border-radius: var(--radius-md);
  background: rgba(30,41,59,0.50); border: 1px solid var(--card-border);
  color: var(--text-200); font-size: 12px; font-weight: 600;
  transition: all 0.2s;
}
.overview-action:hover { background: rgba(51,65,85,0.50); }
.overview-action.enabled { background: rgba(34,197,94,0.15); border-color: rgba(34,197,94,0.50); color: var(--green-400); }
.overview-action svg { width: 16px; height: 16px; }

/* ── Home Cards Grid ────────────────────────────────────── */
.home-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
.home-card {
  background: var(--card); border: 1px solid var(--card-border);
  border-radius: var(--radius-lg); padding: 16px 18px;
  backdrop-filter: var(--blur-sm); -webkit-backdrop-filter: var(--blur-sm);
}
.home-card.wide { grid-column: 1 / -1; }
.home-card-hd { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 12px; }
.home-card-hd h2 { font-size: 14px; font-weight: 700; color: var(--text-100); display: flex; align-items: center; gap: 8px; margin: 0; }
.home-card-hd h2 svg { color: var(--cyan-500); width: 18px; height: 18px; }
.home-card-hd-actions { display: flex; gap: 6px; }
.home-card-link {
  border: 0; background: transparent; color: var(--text-400);
  font-size: 12px; font-weight: 600; padding: 3px 8px;
  border-radius: var(--radius-sm); cursor: pointer; transition: all 0.2s;
}
.home-card-link:hover { background: rgba(30,41,59,0.50); color: var(--text-100); }
.home-card-bd { min-width: 0; }

/* ── Info Row ───────────────────────────────────────────── */
.info-row { display: flex; align-items: center; gap: 10px; padding: 6px 0; min-width: 0; }
.info-row-ico { display: grid; place-items: center; width: 28px; height: 28px; border-radius: var(--radius-sm); background: rgba(30,41,59,0.50); color: var(--cyan-500); flex-shrink: 0; }
.info-row-ico svg { width: 14px; height: 14px; }
.info-row-main { min-width: 0; flex: 1; }
.info-row-main em { display: block; font-style: normal; font-size: 10px; color: var(--text-500); font-weight: 700; letter-spacing: 0.05em; }
.info-row-main b { display: block; font-size: 13px; font-weight: 600; color: var(--text-200); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.info-row-main b.mono { font-family: var(--font-mono); }

/* ── Sub Usage ──────────────────────────────────────────── */
.sub-usage { display: flex; flex-direction: column; gap: 2px; }
.sub-quota { display: flex; align-items: center; gap: 10px; margin-top: 8px; }
.sub-quota-bar { flex: 1; height: 6px; border-radius: var(--radius-full); background: rgba(30,41,59,0.80); overflow: hidden; }
.sub-quota-bar i { display: block; height: 100%; background: var(--grad-cyan); border-radius: var(--radius-full); transition: width 0.3s; }
.sub-quota span { font-size: 11px; color: var(--text-400); font-family: var(--font-mono); }

/* ── Node Hero ──────────────────────────────────────────── */
.node-hero { display: flex; align-items: center; gap: 14px; padding: 8px 0; }
.node-hero-main { flex: 1; min-width: 0; }
.node-hero-name { display: block; font-size: 18px; font-weight: 800; color: var(--text-100); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.node-hero-tags { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
.node-selects { display: flex; gap: 8px; flex-wrap: wrap; }

/* ── Mode Cards ─────────────────────────────────────────── */
.mode-cards.text-only { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.mode-cards.text-only > * {
  padding: 12px; border: 1px solid var(--card-border); border-radius: var(--radius-md);
  background: rgba(30,41,59,0.50); cursor: pointer; transition: all 0.2s;
}
.mode-cards.text-only > *:hover { border-color: var(--cyan-500); }
.mode-tcard-ico { display: grid; place-items: center; width: 28px; height: 28px; border-radius: var(--radius-sm); background: rgba(6,182,212,0.15); color: var(--cyan-500); margin-bottom: 6px; }
.mode-tcard-ico svg { width: 14px; height: 14px; }
.mode-tcard-word { font-size: 13px; font-weight: 700; color: var(--text-100); display: block; }
.mode-tcard-desc { font-size: 10px; color: var(--text-500); display: block; margin-top: 2px; }

/* ── Traffic Grid ───────────────────────────────────────── */
.traffic-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.traffic-cell { padding: 10px 12px; background: rgba(30,41,59,0.50); border: 1px solid rgba(51,65,85,0.50); border-radius: var(--radius-md); min-width: 0; }
.traffic-cell em { display: block; font-style: normal; font-size: 10px; color: var(--text-500); font-weight: 700; letter-spacing: 0.05em; }
.traffic-cell b { display: block; margin-top: 2px; font-size: 13px; font-weight: 800; font-family: var(--font-mono); color: var(--text-100); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ── Stat Tiles ─────────────────────────────────────────── */
.stat-tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
.stat-tile { display: flex; align-items: center; gap: 11px; padding: 12px 14px; background: rgba(30,41,59,0.50); border: 1px solid rgba(51,65,85,0.50); border-radius: var(--radius-md); }
.stat-ico { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; flex-shrink: 0; }
.stat-ico.dn { background: rgba(6,182,212,0.15); color: var(--cyan-400); }
.stat-ico.up { background: rgba(168,85,247,0.15); color: var(--purple-400); }
.stat-ico.total { background: rgba(59,130,246,0.15); color: var(--blue-400); }
.stat-ico.sess { background: rgba(245,158,11,0.15); color: var(--amber-400); }
.stat-tx { min-width: 0; }
.stat-tx em { display: block; font-style: normal; font-size: 10px; color: var(--text-500); font-weight: 700; letter-spacing: 0.05em; }
.stat-tx b { display: block; margin-top: 1px; font-size: 14px; font-weight: 800; font-family: var(--font-mono); color: var(--text-100); }

/* ── Chart Card ─────────────────────────────────────────── */
.chart-card { background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius-lg); padding: 15px 17px 8px; }
.chart-hd { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; flex-wrap: wrap; }
.chart-title { display: flex; align-items: center; gap: 9px; }
.chart-title h2 { font-size: 13px; color: var(--text-100); font-weight: 700; margin: 0; }
.chart-legend { display: flex; gap: 7px; flex-wrap: wrap; }
.chart-legend .lg { font-size: 10px; font-weight: 700; display: flex; align-items: center; gap: 5px; }
.chart-legend .lg.dn { color: var(--cyan-400); }
.chart-legend .lg.up { color: var(--purple-400); }
.chart-legend .lg::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
.chart-body { height: 128px; min-width: 0; }

/* ── Block / Mini Stats ─────────────────────────────────── */
.home-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.block { background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius-lg); padding: 15px 16px; }
.block-hd { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
.block-hd h2 { font-size: 13px; color: var(--text-100); font-weight: 700; display: flex; align-items: center; gap: 7px; margin: 0; }
.block-hd h2 svg { color: var(--cyan-500); }
.block-hd .hd-count { font-size: 11px; color: var(--text-400); font-family: var(--font-mono); background: rgba(30,41,59,0.50); border: 1px solid rgba(51,65,85,0.50); padding: 1px 9px; border-radius: var(--radius-full); }
.mini-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; margin-top: 11px; }
.mini-stats > div { min-width: 0; background: rgba(30,41,59,0.50); border: 1px solid rgba(51,65,85,0.50); border-radius: var(--radius-md); padding: 9px 11px; }
.mini-stats em { display: block; font-style: normal; font-size: 10px; color: var(--text-500); font-weight: 700; }
.mini-stats b { display: block; margin-top: 2px; font-size: 13px; font-weight: 800; font-family: var(--font-mono); color: var(--text-100); }

/* ── Node Jump Card ─────────────────────────────────────── */
.node-jump { width: 100%; cursor: pointer; position: relative; overflow: hidden; background: rgba(30,41,59,0.50); border: 1px solid rgba(51,65,85,0.50); border-radius: var(--radius-md); padding: 12px 14px; transition: all 0.2s; }
.node-jump:hover { border-color: var(--cyan-500); }
.node-jump strong { display: block; margin: 8px 0 5px; font-size: 16px; font-weight: 800; color: var(--text-100); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.node-jump .nj-sub { color: var(--text-400); font-size: 11px; display: flex; align-items: center; gap: 7px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nj-pill { display: inline-flex; align-items: center; gap: 5px; font-size: 10px; font-weight: 700; background: rgba(34,197,94,0.15); color: var(--green-400); border-radius: var(--radius-full); padding: 1px 9px; }

/* ── Connections ────────────────────────────────────────── */
.conn-table { overflow-y: auto; max-height: 260px; }
.conn-table-wrap { overflow: hidden; border-radius: var(--radius-md); }
.conn-line { display: grid; grid-template-columns: minmax(0,1fr) auto 76px; gap: 10px; align-items: center; padding: 9px 4px; border-bottom: 1px solid rgba(51,65,85,0.30); font-size: 13px; }
.conn-line:last-child { border-bottom: 0; }
.conn-host { display: flex; align-items: center; gap: 9px; min-width: 0; }
.conn-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--cyan-500); opacity: 0.55; flex-shrink: 0; }
.conn-line b { font-weight: 600; color: var(--text-100); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; }
.conn-line i { font-style: normal; color: var(--text-400); font-size: 11px; background: rgba(30,41,59,0.50); border-radius: 6px; padding: 1px 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.conn-line em { font-style: normal; font-size: 11px; color: var(--text-500); text-align: right; font-family: var(--font-mono); }
.empty-cta { text-align: center; padding: 8px 4px; display: grid; gap: 10px; justify-items: center; }
.empty-cta .cta-ico { width: 52px; height: 52px; border-radius: 16px; background: rgba(6,182,212,0.15); color: var(--cyan-500); display: grid; place-items: center; }

/* ── Proxies Page ───────────────────────────────────────── */
.px-header-card { background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius-lg); padding: 13px 15px; display: grid; gap: 11px; }
.px-tabs { display: flex; gap: 7px; align-items: center; overflow-x: auto; padding-bottom: 2px; }
.px-tab { display: flex; align-items: center; gap: 9px; padding: 8px 13px; border: 1px solid var(--card-border); border-radius: var(--radius-md); background: rgba(30,41,59,0.50); color: var(--text-200); cursor: pointer; transition: all 0.2s; flex-shrink: 0; }
.px-tab:nth-child(5n+1) { --tint: #06b6d4; }
.px-tab:nth-child(5n+2) { --tint: #3b82f6; }
.px-tab:nth-child(5n+3) { --tint: #a855f7; }
.px-tab:nth-child(5n+4) { --tint: #22c55e; }
.px-tab:nth-child(5n+5) { --tint: #f59e0b; }
.px-tab .gt-ico { width: 32px; height: 32px; border-radius: 10px; display: grid; place-items: center; background: color-mix(in srgb, var(--tint,#06b6d4) 18%, transparent); color: var(--tint,#06b6d4); border: 1px solid color-mix(in srgb, var(--tint,#06b6d4) 25%, transparent); }
.px-tab .gt-ico svg { width: 14px; height: 14px; }
.px-tab b { font-size: 12px; font-weight: 700; max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-100); }
.px-tab small { font-size: 10px; color: var(--text-400); max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--font-mono); }
.px-tab:hover { border-color: var(--cyan-500); }
.px-tab.active { border-color: color-mix(in srgb, var(--tint,#06b6d4) 55%, transparent); background: color-mix(in srgb, var(--tint,#06b6d4) 12%, transparent); }
.px-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 9px; flex-wrap: wrap; }
.px-meta { font-size: 12px; color: var(--text-400); font-family: var(--font-mono); display: flex; align-items: center; gap: 8px; }
.px-meta .meta-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--text-500); }
.px-tools { display: flex; flex-wrap: wrap; gap: 7px; align-items: center; }

/* ── Proxy Card / List ──────────────────────────────────── */
.px-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.px-card { display: flex; align-items: center; gap: 10px; padding: 10px 13px; border: 1px solid var(--card-border); border-radius: var(--radius-md); background: rgba(30,41,59,0.50); cursor: pointer; transition: all 0.2s; }
.px-card:hover { border-color: var(--cyan-500); }
.px-card.active { background: rgba(6,182,212,0.15); border-color: var(--cyan-500); }
.px-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--text-500); }
.px-dot.on { background: var(--cyan-500); box-shadow: 0 0 0 3px rgba(6,182,212,0.25); }
.px-card-main { min-width: 0; display: grid; gap: 3px; flex: 1; }
.px-card-name { font-size: 12px; font-weight: 700; color: var(--text-100); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.px-card-meta { display: flex; gap: 5px; flex-wrap: wrap; font-size: 10px; color: var(--text-400); }
.px-card-meta i { font-style: normal; padding: 0 5px; border-radius: 6px; background: rgba(30,41,59,0.80); border: 1px solid rgba(51,65,85,0.50); }
.px-card-delay { font-family: var(--font-mono); font-size: 13px; font-weight: 800; }
.px-card-delay.good { color: var(--green-400); }
.px-card-delay.mid { color: var(--amber-400); }
.px-card-delay.bad { color: var(--red-400); }
.px-card-delay.na { color: var(--text-500); }

/* ── List Box Rows ──────────────────────────────────────── */
.lb-row { display: grid; grid-template-columns: auto 1fr auto; gap: 8px; align-items: center; padding: 10px 13px; border: 1px solid var(--card-border); border-radius: var(--radius-md); background: rgba(30,41,59,0.50); cursor: pointer; transition: all 0.2s; }
.lb-row:hover { border-color: var(--cyan-500); }
.lb-row.active { background: rgba(6,182,212,0.15); border-color: var(--cyan-500); }
.lb-top { display: flex; align-items: center; gap: 8px; min-width: 0; }
.lb-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; font-weight: 600; flex: 1; color: var(--text-100); }
.lb-check { width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; background: rgba(30,41,59,0.80); color: transparent; border: 1px solid var(--card-border); }
.lb-row.active .lb-check { background: var(--cyan-500); border-color: transparent; color: #fff; }
.lb-bottom { display: flex; align-items: center; gap: 8px; grid-column: 1 / -1; }
.n-tag { font-size: 10px; color: var(--text-500); font-weight: 600; }
.n-tag.on { color: var(--cyan-400); font-weight: 800; }
.n-delay { font-size: 11px; font-weight: 800; border-radius: 6px; padding: 2px 9px; margin-left: auto; font-family: var(--font-mono); }
.n-delay.good { color: var(--green-400); background: rgba(34,197,94,0.15); }
.n-delay.mid { color: var(--amber-400); background: rgba(245,158,11,0.15); }
.n-delay.bad { color: var(--red-400); background: rgba(239,68,68,0.15); }
.n-delay.na { color: var(--text-500); background: rgba(30,41,59,0.50); border: 1px solid rgba(51,65,85,0.50); }

/* ── Profiles Page ──────────────────────────────────────── */
.import-hero { position: relative; overflow: hidden; background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius-lg); padding: 18px; }
.import-hero::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--grad-cyan); }
.import-hero h3 { margin: 0; font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 8px; color: var(--text-100); }
.import-hero h3 svg { color: var(--cyan-500); }
.import-hero p { margin: 5px 0 12px; font-size: 12px; color: var(--text-400); }
.import-bar { display: flex; align-items: center; gap: 8px; background: rgba(30,41,59,0.50); border: 1px solid var(--card-border); border-radius: var(--radius-md); padding: 6px 6px 6px 13px; transition: all 0.2s; }
.import-bar:focus-within { border-color: var(--cyan-500); }
.import-bar input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--text-100); font-size: 13px; }
.pf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: start; }
.pf-card { background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius-lg); overflow: hidden; }
.pf-card-hd { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 15px 10px; border-bottom: 1px solid rgba(51,65,85,0.50); }
.pf-card-hd h2 { font-size: 13px; color: var(--text-100); font-weight: 700; display: flex; align-items: center; gap: 7px; margin: 0; }
.pf-card-hd h2 svg { color: var(--cyan-500); }
.pf-card-hd .hd-count { font-size: 11px; color: var(--text-400); font-family: var(--font-mono); background: rgba(30,41,59,0.50); border: 1px solid rgba(51,65,85,0.50); padding: 1px 9px; border-radius: var(--radius-full); }
.pf-list { display: flex; flex-direction: column; gap: 4px; padding: 8px; max-height: 280px; overflow-y: auto; }
.pf-item { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border: 1px solid transparent; border-radius: var(--radius-md); background: rgba(30,41,59,0.50); cursor: pointer; transition: all 0.2s; }
.pf-item:hover { background: rgba(51,65,85,0.50); }
.pf-item.active { background: rgba(6,182,212,0.15); border-color: var(--cyan-500); }
.pf-item-ico { width: 34px; height: 34px; border-radius: 10px; background: rgba(30,41,59,0.80); border: 1px solid var(--card-border); display: grid; place-items: center; color: var(--cyan-500); flex-shrink: 0; }
.pf-item-ico svg { width: 16px; height: 16px; }
.pf-item-body { min-width: 0; flex: 1; }
.pf-item-body b, .pf-item-name { display: block; font-size: 12px; font-weight: 700; color: var(--text-100); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pf-item-body span, .pf-item-sub { display: block; font-size: 11px; color: var(--text-400); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 2px; }
.pf-item-side { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.pf-item-date { font-size: 10px; color: var(--text-500); font-family: var(--font-mono); white-space: nowrap; }
.pf-seg { display: inline-flex; gap: 2px; padding: 3px; background: rgba(30,41,59,0.50); border: 1px solid var(--card-border); border-radius: 10px; }
.pf-sub { font-size: 11px; color: var(--text-400); margin-top: 2px; }
.pf-enhance { display: flex; flex-direction: column; gap: 8px; }
.pf-nodes { display: flex; flex-wrap: wrap; gap: 6px; }
.pf-yaml { border: 1px solid var(--card-border); border-radius: var(--radius-md); overflow: hidden; background: rgba(30,41,59,0.50); }

/* ── Settings Page ──────────────────────────────────────── */
.s-page { display: flex; flex-direction: column; gap: 14px; }
.s-page-split { display: grid; grid-template-columns: 160px 1fr; gap: 16px; align-items: start; }
.s-main { min-width: 0; display: flex; flex-direction: column; gap: 14px; }
.s-card { background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius-lg); padding: 16px 18px; }
.s-card-hd { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 12px; }
.s-card-bd { min-width: 0; }
.s-card h2 { font-size: 13px; font-weight: 700; color: var(--text-100); margin-bottom: 12px; display: flex; align-items: center; gap: 7px; }
.s-card h2 svg { color: var(--cyan-500); }
.s-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px solid rgba(51,65,85,0.30); }
.s-row:last-child { border-bottom: 0; }
.s-row-lb, .s-row-text { min-width: 0; flex: 1; }
.s-row-label { display: block; font-size: 12px; font-weight: 700; color: var(--text-100); }
.s-row-desc { display: block; font-size: 11px; color: var(--text-400); margin-top: 2px; line-height: 1.5; }
.s-row-ctrl { flex-shrink: 0; display: flex; align-items: center; gap: 8px; }
/* 主题自适应：不再硬编码深色 slate，浅色/深色共用同一套规则 */
.s-nav { display: flex; gap: 4px; flex-wrap: wrap; padding: 4px; background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius-md); }
.s-nav button { padding: 7px 14px; border: 1px solid transparent; border-radius: var(--radius-sm); background: transparent; color: var(--text-400); font-size: 12px; font-weight: 600; transition: all 0.2s; }
.s-nav button:hover { background: color-mix(in srgb, var(--text-100) 8%, transparent); color: var(--text-100); }
.s-nav button.active { background: color-mix(in srgb, var(--accent) 14%, transparent); border-color: color-mix(in srgb, var(--accent) 30%, transparent); color: var(--accent); }
.s-fields { display: grid; gap: 10px; }
.s-input { width: 100%; min-height: 34px; padding: 6px 12px; border: 1px solid var(--input-border); border-radius: var(--radius-md); background: var(--input-bg); color: var(--text-100); font-size: 13px; outline: 0; }
.s-input:focus { border-color: var(--cyan-500); box-shadow: 0 0 0 3px rgba(6,182,212,0.25); }
.s-input.full { width: 100%; }
.s-hint { font-size: 11px; color: var(--text-400); line-height: 1.6; padding: 8px 12px; background: rgba(30,41,59,0.50); border: 1px solid rgba(51,65,85,0.50); border-radius: var(--radius-md); }
.s-mono { font-family: var(--font-mono); font-size: 11px; }
.s-foot { display: flex; align-items: center; justify-content: flex-end; gap: 8px; padding-top: 10px; border-top: 1px solid rgba(51,65,85,0.50); }
.s-warn { font-size: 11px; color: var(--amber-400); background: rgba(245,158,11,0.15); border: 1px solid rgba(245,158,11,0.30); border-radius: var(--radius-md); padding: 8px 12px; line-height: 1.5; }
.s-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.s-path { font-family: var(--font-mono); font-size: 11px; color: var(--text-400); background: rgba(30,41,59,0.50); border: 1px solid rgba(51,65,85,0.50); border-radius: 6px; padding: 4px 10px; user-select: text; }
.s-field-block { display: grid; gap: 6px; }
.s-field-block label { font-size: 11px; font-weight: 700; color: var(--text-300); }
.s-muted { color: var(--text-400); font-size: 12px; }
.s-meta { display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--text-400); flex-wrap: wrap; }

/* ── Pill / Badge ───────────────────────────────────────── */
.pill { display: inline-flex; align-items: center; gap: 5px; padding: 2px 10px; border-radius: var(--radius-full); background: rgba(30,41,59,0.50); border: 1px solid var(--card-border); font-size: 11px; font-weight: 700; color: var(--text-200); }
.pill.dim { color: var(--text-500); background: rgba(30,41,59,0.30); border-color: rgba(51,65,85,0.30); }

/* ── Terminal ───────────────────────────────────────────── */
.term-bar { display: flex; align-items: center; gap: 8px; padding: 8px 14px; background: rgba(30,41,59,0.50); border-bottom: 1px solid rgba(51,65,85,0.50); }
.term-title { font-size: 11px; font-weight: 700; color: var(--text-200); }
.term-dots { display: flex; gap: 5px; }
.term-dots i { width: 8px; height: 8px; border-radius: 50%; background: rgba(51,65,85,0.80); }
.term-body { padding: 12px 14px; font-family: var(--font-mono); font-size: 11px; line-height: 1.7; color: var(--text-300); max-height: 320px; overflow-y: auto; background: rgba(0,0,0,0.20); user-select: text; }

/* ── Unlock / Tests Page ────────────────────────────────── */
.unlock-page { display: flex; flex-direction: column; gap: 16px; }
.unlock-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.unlock-top h1 { margin: 0; font-size: 22px; font-weight: 800; color: var(--text-100); }
.unlock-grid.verge { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
.ul-card { background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius-md); padding: 14px 16px; }
.ul-card-hd { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
.ul-card-hd h3 { margin: 0; font-size: 15px; font-weight: 700; color: var(--text-100); }
.ul-refresh { width: 28px; height: 28px; border: 1px solid var(--card-border); border-radius: 8px; background: rgba(30,41,59,0.50); color: var(--text-400); display: grid; place-items: center; cursor: pointer; }
.ul-refresh:hover { color: var(--cyan-500); border-color: var(--cyan-500); }
.ul-status { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; min-height: 26px; margin-top: 8px; }
.ul-wait { font-size: 12px; color: var(--text-400); }
.ul-badge { font-size: 11px; font-weight: 700; padding: 2px 10px; border-radius: var(--radius-full); }
.ul-badge.ok { background: rgba(34,197,94,0.15); color: var(--green-400); }
.ul-badge.no { background: rgba(239,68,68,0.15); color: var(--red-400); }
.ul-badge.fail { background: rgba(245,158,11,0.15); color: var(--amber-400); }
.ul-region { display: flex; align-items: center; gap: 5px; font-size: 12px; color: var(--text-200); }
.ul-region i { width: 7px; height: 7px; border-radius: 50%; background: var(--red-400); }
.ul-time { font-size: 11px; color: var(--text-500); font-family: var(--font-mono); }

/* ── WebTest / IP ───────────────────────────────────────── */
.webtest-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px; }
.webtest-item { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 14px 10px; background: rgba(30,41,59,0.50); border: 1px solid rgba(51,65,85,0.50); border-radius: var(--radius-md); }
.webtest-logo { width: 36px; height: 36px; border-radius: 10px; background: rgba(30,41,59,0.80); border: 1px solid var(--card-border); display: grid; place-items: center; font-size: 16px; }
.webtest-name { font-size: 11px; font-weight: 700; color: var(--text-200); text-align: center; }
.ip-main { display: flex; flex-direction: column; gap: 4px; }
.ip-flag { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 24px; border-radius: 6px; background: rgba(30,41,59,0.80); border: 1px solid var(--card-border); font-size: 11px; font-weight: 800; color: var(--text-200); }
.ip-addr { font-family: var(--font-mono); font-size: 14px; font-weight: 700; color: var(--text-100); user-select: text; }
.ip-loc { font-size: 11px; }
.status-pill { display: inline-flex; align-items: center; gap: 5px; padding: 2px 10px; border-radius: var(--radius-full); font-size: 11px; font-weight: 700; background: rgba(34,197,94,0.15); color: var(--green-400); }
.ok-text { color: var(--green-400); }
.mono { font-family: var(--font-mono); }

/* ── Buttons extended ───────────────────────────────────── */
.btn.primary { background: var(--cyan-500); color: var(--bg-0); }
.btn.primary:hover { background: var(--cyan-400); }
.btn.danger { background: rgba(239,68,68,0.20); color: var(--red-400); border-color: rgba(239,68,68,0.30); }
.btn.danger:hover { background: var(--red-500); color: #fff; }
.btn.ghost { background: transparent; border-color: transparent; color: var(--text-400); }
.btn.ghost:hover { background: rgba(30,41,59,0.50); color: var(--text-100); }
.seg { display: inline-flex; padding: 3px; border-radius: var(--radius-md); background: rgba(30,41,59,0.50); border: 1px solid var(--card-border); gap: 2px; }
.seg button { min-height: 32px; padding: 5px 12px; border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--text-400); font-size: 12px; font-weight: 600; transition: all 0.2s; }
.seg button.active { background: rgba(51,65,85,0.70); color: var(--text-100); border: 1px solid var(--card-border); }

/* ── Search / Select / Field ────────────────────────────── */
.search, .select, .field input {
  width: 100%; min-height: 34px; padding: 6px 12px;
  border: 1px solid var(--input-border); border-radius: var(--radius-md);
  background: var(--input-bg); color: var(--text-100); font-size: 13px; outline: 0;
}
.search:focus, .select:focus, .field input:focus { border-color: var(--cyan-500); box-shadow: 0 0 0 3px rgba(6,182,212,0.25); }
.textarea { width: 100%; min-height: 80px; padding: 10px 12px; border: 1px solid var(--input-border); border-radius: var(--radius-md); background: var(--input-bg); color: var(--text-100); font-size: 12px; font-family: var(--font-mono); outline: 0; resize: vertical; }
.textarea:focus { border-color: var(--cyan-500); }

/* ── Progress Line ──────────────────────────────────────── */
.progress-line { height: 4px; border-radius: var(--radius-full); background: rgba(30,41,59,0.80); overflow: hidden; }
.progress-line > i { display: block; height: 100%; background: var(--grad-cyan); border-radius: var(--radius-full); transition: width 0.2s; }

/* ── Empty / Toast / Modal ──────────────────────────────── */
.empty { color: var(--text-500); font-size: 13px; padding: 22px 8px; text-align: center; }
.empty.slim { padding: 14px 8px; }
.toast {
  position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%);
  padding: 10px 22px; border-radius: var(--radius-full);
  background: rgba(30,41,59,0.80); backdrop-filter: var(--blur);
  border: 1px solid var(--card-border); color: var(--text-100);
  font-size: 13px; font-weight: 600; box-shadow: 0 12px 40px rgba(0,0,0,0.28); z-index: 999;
}
.modal-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.45);
  backdrop-filter: blur(6px); z-index: 100;
  display: grid; place-items: center;
}
.modal-box {
  background: rgba(30,41,59,0.80); backdrop-filter: var(--blur);
  border: 1px solid var(--card-border); border-radius: var(--radius-lg);
  padding: 22px 24px; min-width: 320px; max-width: 520px;
  max-height: 80vh; overflow-y: auto; box-shadow: 0 12px 40px rgba(0,0,0,0.28);
}
.modal-box h3 { margin: 0 0 12px; font-size: 16px; font-weight: 700; color: var(--text-100); }

/* ── Editor / YAML ──────────────────────────────────────── */
.editor-bar { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: rgba(30,41,59,0.50); border: 1px solid var(--card-border); border-radius: var(--radius-md) var(--radius-md) 0 0; border-bottom: 0; flex-wrap: wrap; }
.editor-bar input { flex: 1; min-width: 0; min-height: 30px; padding: 4px 12px; border: 1px solid var(--card-border); border-radius: 8px; background: var(--input-bg); color: var(--text-100); font-size: 12px; outline: 0; }
.yaml-editor { border: 1px solid var(--card-border); border-radius: var(--radius-md); overflow: hidden; background: rgba(30,41,59,0.50); }
.visual-ed { display: flex; flex-direction: column; gap: 12px; }
.editor-card { background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius-lg); overflow: hidden; }

/* ── Home Config Modal ──────────────────────────────────── */
.home-cfg { background: rgba(30,41,59,0.80); backdrop-filter: var(--blur); border: 1px solid var(--card-border); border-radius: var(--radius-lg); padding: 20px 22px; min-width: 320px; max-width: 440px; }
.home-cfg-hd { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.home-cfg-title { font-size: 16px; font-weight: 800; color: var(--text-100); }
.home-cfg-sub { font-size: 11px; color: var(--text-400); margin-top: 3px; }
.home-cfg-close { width: 28px; height: 28px; border: 1px solid var(--card-border); border-radius: 8px; background: rgba(30,41,59,0.80); color: var(--text-400); display: grid; place-items: center; cursor: pointer; }
.home-cfg-list { display: flex; flex-direction: column; gap: 4px; max-height: 320px; overflow-y: auto; }
.home-cfg-check { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: var(--radius-md); cursor: pointer; }
.home-cfg-check:hover { background: rgba(51,65,85,0.50); }
.home-cfg-text { flex: 1; min-width: 0; }
.home-cfg-label { display: block; font-size: 12px; font-weight: 700; color: var(--text-100); }
.home-cfg-desc { display: block; font-size: 11px; color: var(--text-400); margin-top: 1px; }
.home-cfg-ft { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(51,65,85,0.50); }
.mini-switch { width: 36px; height: 20px; border-radius: var(--radius-full); background: var(--text-600); position: relative; transition: background 0.2s; }
.mini-switch::after { content: ""; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%; background: #fff; transition: transform 0.2s; }
.mini-switch.on { background: var(--cyan-500); }
.mini-switch.on::after { transform: translateX(16px); }

/* ── Pages ──────────────────────────────────────────────── */
/* display 由 .pane 统一提供；此处不再各自声明 gap，避免 12/14/16 混用 */
.rules-page, .conn-page, .tests-page { display: flex; flex-direction: column; }

/* ── Misc ───────────────────────────────────────────────── */
.link-btn { border: 0; background: none; color: var(--cyan-400); font-size: inherit; font-weight: 600; cursor: pointer; padding: 0; text-decoration: underline; text-underline-offset: 2px; }
.link-btn:hover { color: var(--cyan-300); }
.spin { animation: spin 0.8s linear infinite; }
.sparkline { display: block; width: 100%; height: 28px; }
.connect-orb { display: grid; place-items: center; }

/* ── Final fixes ────────────────────────────────────────── */
.muted { color: var(--text-400); font-size: 13px; line-height: 1.6; }
.hero-orb-btn { width: 64px; height: 64px; border-radius: 20px; border: 1px solid var(--card-border); background: rgba(30,41,59,0.50); color: var(--text-100); display: grid; place-items: center; transition: all 0.2s; cursor: pointer; }
.hero-orb-btn:hover { border-color: var(--cyan-500); color: var(--cyan-500); }

/* ── Window Drag Regions ────────────────────────────────── */
.header { -webkit-app-region: drag; }
.header-search, .header-icons, .header-actions button, .header-actions input {
  -webkit-app-region: no-drag;
}

/* ── Light Theme Override ───────────────────────────────── */
[data-theme="light"] {
  --bg-0: #f0f2f5;
  --bg-1: #e4e7ec;
  --card: rgba(255, 255, 255, 0.85);
  --card-border: rgba(200, 210, 225, 0.60);
  --card-solid: #ffffff;
  --input-bg: rgba(255, 255, 255, 0.80);
  --input-border: rgba(200, 210, 225, 0.60);

  --text-100: #1a202c;
  --text-200: #2d3748;
  --text-300: #4a5568;
  --text-400: #718096;
  --text-500: #a0aec0;
  --text-600: #cbd5e0;

  --cyan-400: #0891b2;
  --cyan-500: #0e7490;
  --accent: var(--cyan-500);
  --ok: #16a34a;
  --warn: #d97706;
  --bad: #dc2626;

  --grad-cyan: linear-gradient(to right, #0891b2, #2563eb);
  --grad-purple: linear-gradient(to right, #9333ea, #ec4899);
  --grad-blue: linear-gradient(to right, #2563eb, #6366f1);
  --grad-green: linear-gradient(to right, #16a34a, #059669);
  --grad-text: linear-gradient(to right, #0891b2, #2563eb);
}

[data-theme="light"] .particle-canvas { opacity: 0.15; }
[data-theme="light"] .app::before {
  background:
    radial-gradient(ellipse at 20% 50%, rgba(8, 145, 178, 0.08) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(37, 99, 235, 0.06) 0%, transparent 50%);
}
[data-theme="light"] .card { background: rgba(255, 255, 255, 0.85); }
[data-theme="light"] .nav-item.active {
  background: rgba(8, 145, 178, 0.10);
  color: var(--cyan-500);
}
[data-theme="light"] .nav-item { color: var(--text-400); }
[data-theme="light"] .nav-item:hover { color: var(--text-100); background: rgba(0,0,0,0.04); }
[data-theme="light"] .btn-cyan { background: var(--cyan-500); color: #fff; }
[data-theme="light"] .btn-cyan:hover { background: var(--cyan-400); }
[data-theme="light"] .btn-danger { background: rgba(220,38,38,0.12); color: var(--bad); border-color: rgba(220,38,38,0.30); }
[data-theme="light"] .badge-cyan { background: rgba(8,145,178,0.12); color: var(--cyan-500); border-color: rgba(8,145,178,0.30); }
[data-theme="light"] .time-display { background: linear-gradient(to bottom right, rgba(255,255,255,0.60), rgba(240,242,245,0.60)); }
[data-theme="light"] .time-value { color: var(--cyan-500); }
[data-theme="light"] .header-brand .brand-text {
  background: var(--grad-text);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
[data-theme="light"] .header-search { background: rgba(255,255,255,0.70); border-color: rgba(200,210,225,0.50); }
[data-theme="light"] .header-search input { color: var(--text-100); }
[data-theme="light"] .header-search input::placeholder { color: var(--text-500); }
[data-theme="light"] .icon-btn { color: var(--text-400); }
[data-theme="light"] .icon-btn:hover { color: var(--text-100); background: rgba(0,0,0,0.05); }
[data-theme="light"] .header { border-bottom-color: rgba(200,210,225,0.50); }
[data-theme="light"] .status-bar { background: rgba(0,0,0,0.06); }
[data-theme="light"] .status-bar > i.cyan { background: var(--grad-cyan); }
[data-theme="light"] .metric-card { background: rgba(255,255,255,0.70); border-color: rgba(200,210,225,0.50); }
[data-theme="light"] .action-btn { background: rgba(255,255,255,0.70); border-color: rgba(200,210,225,0.50); }
[data-theme="light"] .action-btn:hover { background: rgba(255,255,255,0.90); }
[data-theme="light"] .action-btn svg { color: var(--cyan-500); }
[data-theme="light"] .nav-section-title { color: var(--text-500); }
[data-theme="light"] .progress, [data-theme="light"] .status-bar { background: rgba(0,0,0,0.06); }
[data-theme="light"] .toast { background: rgba(255,255,255,0.90); border-color: rgba(200,210,225,0.50); color: var(--text-100); }
[data-theme="light"] .modal-mask { background: rgba(0,0,0,0.25); }
[data-theme="light"] .modal-box { background: rgba(255,255,255,0.95); border-color: rgba(200,210,225,0.50); }
[data-theme="light"] .home-card { background: rgba(255,255,255,0.85); border-color: rgba(200,210,225,0.50); }
[data-theme="light"] .overview-strip { background: rgba(255,255,255,0.85); border-color: rgba(200,210,225,0.50); }
[data-theme="light"] .info-row-ico { background: rgba(8,145,178,0.10); color: var(--cyan-500); }
[data-theme="light"] .block { background: rgba(255,255,255,0.85); border-color: rgba(200,210,225,0.50); }
[data-theme="light"] .pf-card { background: rgba(255,255,255,0.85); border-color: rgba(200,210,225,0.50); }
[data-theme="light"] .s-card { background: rgba(255,255,255,0.85); border-color: rgba(200,210,225,0.50); }
[data-theme="light"] .px-header-card { background: rgba(255,255,255,0.85); border-color: rgba(200,210,225,0.50); }
[data-theme="light"] .import-hero { background: rgba(255,255,255,0.85); border-color: rgba(200,210,225,0.50); }
[data-theme="light"] .term-body { background: rgba(0,0,0,0.03); color: var(--text-300); }
[data-theme="light"] .text-muted { color: var(--text-400); }
[data-theme="light"] .text-faint { color: var(--text-500); }
[data-theme="light"] .text-cyan { color: var(--cyan-500); }
[data-theme="light"] .text-green { color: var(--ok); }
[data-theme="light"] .text-purple { color: var(--purple-500, #9333ea); }
[data-theme="light"] .text-blue { color: var(--blue-500, #2563eb); }
[data-theme="light"] .muted { color: var(--text-400); }
[data-theme="light"] .empty { color: var(--text-500); }
[data-theme="light"] .input, [data-theme="light"] .s-input, [data-theme="light"] .search, [data-theme="light"] .select, [data-theme="light"] .field input {
  background: rgba(255,255,255,0.80);
  border-color: rgba(200,210,225,0.60);
  color: var(--text-100);
}
[data-theme="light"] .input:focus, [data-theme="light"] .s-input:focus {
  border-color: var(--cyan-500);
  box-shadow: 0 0 0 3px rgba(8,145,178,0.20);
}
[data-theme="light"] .badge-green { background: rgba(22,163,74,0.12); color: var(--ok); border-color: rgba(22,163,74,0.30); }
[data-theme="light"] .badge-red { background: rgba(220,38,38,0.12); color: var(--bad); border-color: rgba(220,38,38,0.30); }
[data-theme="light"] .badge-amber { background: rgba(217,119,6,0.12); color: var(--warn); border-color: rgba(217,119,6,0.30); }
[data-theme="light"] .ul-badge.ok { background: rgba(22,163,74,0.12); color: var(--ok); }
[data-theme="light"] .ul-badge.no { background: rgba(220,38,38,0.12); color: var(--bad); }
[data-theme="light"] .ul-badge.fail { background: rgba(217,119,6,0.12); color: var(--warn); }
[data-theme="light"] .n-delay.good { color: var(--ok); background: rgba(22,163,74,0.12); }
[data-theme="light"] .n-delay.mid { color: var(--warn); background: rgba(217,119,6,0.12); }
[data-theme="light"] .n-delay.bad { color: var(--bad); background: rgba(220,38,38,0.12); }
[data-theme="light"] .link-btn { color: var(--cyan-500); }
[data-theme="light"] .status-pill { background: rgba(22,163,74,0.12); color: var(--ok); }
[data-theme="light"] .ok-text { color: var(--ok); }
[data-theme="light"] .switch { background: var(--text-600); }
[data-theme="light"] .switch.on { background: var(--cyan-500); }
[data-theme="light"] .seg { background: rgba(0,0,0,0.04); border-color: rgba(200,210,225,0.50); }
[data-theme="light"] .seg button.active { background: rgba(255,255,255,0.90); color: var(--text-100); border-color: rgba(200,210,225,0.50); }
[data-theme="light"] .pill { background: rgba(0,0,0,0.04); border-color: rgba(200,210,225,0.50); color: var(--text-200); }
[data-theme="light"] .tabs-list { background: rgba(0,0,0,0.04); }
[data-theme="light"] .tabs-trigger.active { background: rgba(255,255,255,0.90); color: var(--cyan-500); }
/* 修复：label.switch 开关标签布局（代理页自动测速/选用最优） */
label.switch.compact {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  width: auto;
  height: auto;
  background: none;
  border-radius: 0;
  cursor: pointer;
  white-space: nowrap;
  font-size: 12px;
  color: var(--text-600);
}
label.switch.compact::after { display: none; }
label.switch.compact input[type="checkbox"] {
  appearance: none;
  -webkit-appearance: none;
  position: relative;
  width: 36px;
  height: 20px;
  border-radius: 999px;
  background: var(--text-400);
  cursor: pointer;
  transition: background 0.2s;
  flex-shrink: 0;
  margin: 0;
}
label.switch.compact input[type="checkbox"]::after {
  content: "";
  position: absolute;
  top: 2px;
  left: 2px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #fff;
  transition: transform 0.2s;
}
label.switch.compact input[type="checkbox"]:checked { background: var(--cyan-500); }
label.switch.compact input[type="checkbox"]:checked::after { transform: translateX(16px); }

/* 修复：代理页搜索框样式（之前没有对应 CSS，用的是浏览器默认黑底） */
.proxies-search {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--bg-soft, #f1f5f9);
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 8px;
  padding: 6px 10px;
  color: var(--text-500, #64748b);
  cursor: text;
}
.proxies-search input {
  border: none;
  outline: none;
  background: transparent;
  font-size: 12px;
  color: var(--text-900, #0f172a);
  width: 140px;
}
.proxies-search input::placeholder { color: var(--text-400, #94a3b8); }
[data-theme="dark"] .proxies-search { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.12); color: #94a3b8; }
[data-theme="dark"] .proxies-search input { color: #e2e8f0; }
[data-theme="dark"] .proxies-search input::placeholder { color: #64748b; }

/* -- Stage: 全站唯一滚动宿主，统一内边距 -- */
.stage {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 22px 26px 34px;
}
.stage::-webkit-scrollbar { width: 6px; }
.stage::-webkit-scrollbar-thumb { background: rgba(120,130,150,0.35); border-radius: 99px; }
/* -- Node Hero card polish (fix odd look) -- */
.node-hero { align-items: center; gap: 12px; padding: 4px 0 10px; border-bottom: 1px solid rgba(120,130,150,0.15); margin-bottom: 10px; }
.node-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--text-500); flex-shrink: 0; }
.node-dot.on { background: var(--ok); box-shadow: 0 0 8px var(--ok); animation: pulse 2s infinite; }
.node-hero-name { font-size: 17px; letter-spacing: -0.01em; }
.node-hero-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 5px; }
.node-hero-tags em,
.node-hero-tags i {
  font-style: normal;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 2px 8px;
  border-radius: 99px;
  background: rgba(8, 145, 178, 0.10);
  color: var(--cyan-500);
  border: 1px solid rgba(8, 145, 178, 0.25);
}
.node-hero-tags i { background: rgba(147, 51, 234, 0.10); color: #9333ea; border-color: rgba(147, 51, 234, 0.25); }
.node-delay {
  margin-left: auto;
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: 14px;
  font-weight: 800;
  padding: 5px 12px;
  border-radius: 10px;
  line-height: 1;
}
.node-delay.good { color: var(--ok); background: rgba(22, 163, 74, 0.12); }
.node-delay.mid { color: var(--warn); background: rgba(217, 119, 6, 0.12); }
.node-delay.bad { color: var(--bad); background: rgba(220, 38, 38, 0.12); }
.node-delay.na { color: var(--text-500); background: rgba(120, 130, 150, 0.10); }
.node-selects { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 4px; }
.node-selects > div { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.node-selects em {
  font-style: normal;
  font-size: 11px;
  font-weight: 700;
  color: var(--text-400);
  letter-spacing: 0.03em;
}
.node-selects select {
  width: 100%;
  height: 36px;
  padding: 0 10px;
  border: 1px solid var(--input-border);
  border-radius: var(--radius-md);
  background: var(--input-bg);
  color: var(--text-100);
  font-size: 13px;
  font-weight: 600;
  outline: none;
  cursor: pointer;
  transition: border-color 0.2s, box-shadow 0.2s;
  appearance: auto;
}
.node-selects select:focus { border-color: var(--cyan-500); box-shadow: 0 0 0 3px rgba(8, 145, 178, 0.20); }
.node-selects select:disabled { opacity: 0.60; cursor: not-allowed; }
[data-theme="light"] .node-selects select { background: rgba(255, 255, 255, 0.90); color: var(--text-100); }
/* -- Tile readability: neutral high-contrast, no garish fill -- */
.traffic-cell em { color: var(--text-400); font-weight: 600; }
.traffic-cell b { color: var(--text-100); }
.webtest-name { color: var(--text-300); }
.mode-tcard-desc { color: var(--text-400); }
.mode-tcard { transition: background 0.2s, border-color 0.2s; }
.mode-tcard.active {
  background: rgba(6, 182, 212, 0.08);
  border-color: rgba(6, 182, 212, 0.55);
}

/* light theme: white tiles + dark ink (readable, still neutral) */
[data-theme="light"] .traffic-cell,
[data-theme="light"] .webtest-item,
[data-theme="light"] .mode-cards.text-only > * {
  background: #ffffff;
  border-color: rgba(200, 210, 225, 0.65);
}
[data-theme="light"] .traffic-cell:hover,
[data-theme="light"] .webtest-item:hover,
[data-theme="light"] .mode-cards.text-only > *:hover {
  border-color: rgba(8, 145, 178, 0.45);
}
[data-theme="light"] .traffic-cell em,
[data-theme="light"] .webtest-name,
[data-theme="light"] .mode-tcard-desc { color: var(--text-400); }
[data-theme="light"] .traffic-cell b,
[data-theme="light"] .mode-tcard-word { color: var(--text-100); }
[data-theme="light"] .mode-tcard.active {
  background: rgba(8, 145, 178, 0.06);
  border-color: rgba(8, 145, 178, 0.55);
}
[data-theme="light"] .webtest-logo { background: #f1f3f7; border-color: rgba(200, 210, 225, 0.65); }
[data-theme="light"] .link-btn { color: var(--cyan-500); font-weight: 700; }
/* -- Remove colored/gray base fills across the app (keep cards, borders, text) -- */
.traffic-cell, .webtest-item, .webtest-logo, .stat-tile, .stat-ico,
.mini-stats > div, .mode-cards.text-only > *, .mode-tcard-ico,
.action-btn, .metric-card, .px-card, .pf-item, .pf-item-ico,
.lb-row, .ul-card, .storage-item, .node-jump,
.tabs-list, .seg, .header-search, .import-bar, .term-bar,
.conn-line i, .px-card-meta i, .info-row-ico, .empty-cta .cta-ico,
.overview-action, .btn-outline, .pill, .badge-outline,
.yaml-editor, .editor-bar, .s-hint, .s-path, .term-dots i,
.mode-tcard.active, .px-card.active, .pf-item.active {
  background: transparent;
}
.data-box {
  background: transparent !important;
}

/* keep hover feedback readable without fills */
[data-theme="light"] .action-btn:hover { background: rgba(0, 0, 0, 0.03); }
[data-theme="light"] .seg button.active,
[data-theme="light"] .tabs-trigger.active { background: rgba(0, 0, 0, 0.04); }
/* light-theme wins: strip remaining fills */
[data-theme="light"] .traffic-cell,
[data-theme="light"] .webtest-item,
[data-theme="light"] .webtest-logo,
[data-theme="light"] .stat-tile,
[data-theme="light"] .stat-ico,
[data-theme="light"] .mini-stats > div,
[data-theme="light"] .mode-cards.text-only > *,
[data-theme="light"] .mode-tcard-ico,
[data-theme="light"] .mode-tcard.active,
[data-theme="light"] .action-btn,
[data-theme="light"] .metric-card,
[data-theme="light"] .px-card,
[data-theme="light"] .px-card.active,
[data-theme="light"] .pf-item,
[data-theme="light"] .pf-item.active,
[data-theme="light"] .pf-item-ico,
[data-theme="light"] .lb-row,
[data-theme="light"] .ul-card,
[data-theme="light"] .storage-item,
[data-theme="light"] .node-jump,
[data-theme="light"] .tabs-list,
[data-theme="light"] .seg,
[data-theme="light"] .header-search,
[data-theme="light"] .import-bar,
[data-theme="light"] .term-bar,
[data-theme="light"] .info-row-ico,
[data-theme="light"] .overview-action,
[data-theme="light"] .pill,
[data-theme="light"] .yaml-editor,
[data-theme="light"] .editor-bar,
[data-theme="light"] .s-hint { background: transparent; }

/* ============================================================
   Tab layout pass
   Only layout, spacing and presentation are changed here.
   Data contracts and interaction classes stay untouched.
   ============================================================ */
.pane {
  width: 100%;
  max-width: 1280px;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* Proxies: group rail -> toolbar -> dense node matrix. */
.px-header-card { position: sticky; top: 0; z-index: 4; gap: 14px; padding: 14px; background: color-mix(in srgb, var(--card-solid, var(--card)) 94%, transparent); box-shadow: 0 8px 22px rgba(2, 6, 23, .14); }
.px-tabs { gap: 8px; padding: 0 0 2px; scrollbar-width: thin; }
.px-tab { min-width: 172px; min-height: 52px; padding: 8px 12px; border-radius: 10px; }
.px-tab .gt-ico { width: 30px; height: 30px; border-radius: 8px; }
.px-tab b { max-width: 150px; }
.px-tab small { max-width: 150px; }
.px-toolbar { align-items: center; padding-top: 2px; }
.px-meta { min-height: 32px; padding: 0 2px; }
.px-tools { justify-content: flex-end; gap: 8px; }
.px-tools .switch.compact { min-height: 32px; padding: 4px 9px; }
.px-tools .proxies-search { width: 220px; min-height: 34px; }
.px-grid { grid-template-columns: repeat(auto-fill, minmax(232px, 1fr)); gap: 10px; align-content: start; }
.px-card { min-height: 66px; padding: 11px 13px; border-radius: 10px; text-align: left; }
.px-card-main { gap: 5px; }
.px-card-name { font-size: 12.5px; }
.px-card-meta { min-height: 16px; align-items: center; }
.px-card-delay { min-width: 46px; text-align: right; }
.px-card.best::after { content: "BEST"; position: absolute; top: 7px; right: 8px; font: 700 9px var(--font-mono); color: var(--accent); letter-spacing: .08em; }
.px-card { position: relative; }

/* Profiles: import action stays prominent, content becomes two balanced columns. */
.import-hero { padding: 20px; border-radius: 12px; }
.import-hero h3 { font-size: 16px; }
.import-hero p { max-width: 760px; line-height: 1.6; }
.pf-seg { margin-top: 14px !important; }
.import-bar { min-height: 42px; }
.pf-grid { grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr); gap: 14px; }
.pf-card { min-height: 320px; }
.pf-list { max-height: 390px; padding: 10px; gap: 6px; }
.pf-item { min-height: 54px; padding: 9px 11px; }
.pf-yaml { min-height: 420px; }

/* Connections: controls read as a compact query bar, table uses fixed rhythm. */
.conn-page > .block-hd, .rules-page > .block-hd { display: flex; align-items: center; gap: 10px; min-height: 42px; margin-bottom: 0 !important; }
.conn-page > .block-hd h2, .rules-page > .block-hd h2 { font-size: 19px; color: var(--text-100); }
.conn-page > .import-bar, .rules-page > .import-bar { min-height: 44px; margin-bottom: 0 !important; }
.conn-table-wrap { border: 1px solid var(--card-border); border-radius: 12px; background: var(--card); overflow: auto; box-shadow: var(--shadow-sm); }
.conn-table { width: 100%; min-width: 820px; border-collapse: collapse; max-height: none; }
.conn-table thead { position: sticky; top: 0; z-index: 1; background: color-mix(in srgb, var(--card-solid, var(--card)) 96%, transparent); }
.conn-table th { padding: 12px 14px; text-align: left; color: var(--text-400); font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; border-bottom: 1px solid var(--card-border); white-space: nowrap; }
.conn-table td { padding: 12px 14px; color: var(--text-200); font-size: 12px; border-bottom: 1px solid rgba(51,65,85,.28); vertical-align: middle; }
.conn-table tbody tr { transition: background .15s ease; }
.conn-table tbody tr:hover { background: rgba(84,214,195,.055); }
.conn-table tbody tr:last-child td { border-bottom: 0; }

/* Rules: editing tools first, virtualized list gets a framed workspace. */
.rules-page > .s-muted { max-width: 760px; margin: -4px 0 0 !important; line-height: 1.65; }
.rules-page > .pf-list { min-height: 360px; max-height: calc(100vh - 360px); padding: 10px; border: 1px solid var(--card-border); border-radius: 12px; background: var(--card); box-shadow: var(--shadow-sm); }
.rules-page > .pf-list .pf-item { min-height: 52px; }

/* Tests: cards form a readable matrix with consistent action placement. */
.unlock-top { min-height: 42px; justify-content: space-between !important; }
.unlock-top::before { content: "解锁测试"; font-size: 19px; font-weight: 800; color: var(--text-100); }
.unlock-grid.verge { grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; }
.ul-card { min-height: 116px; padding: 15px 16px; border-radius: 11px; display: flex; flex-direction: column; }
.ul-card-hd h3 { font-size: 13px; }
.ul-status { flex: 1; align-content: center; }
.ul-time { padding-top: 9px; border-top: 1px solid rgba(51,65,85,.28); }

/* Logs: one terminal surface with a persistent header. */
.term { max-width: 1280px; height: 100%; display: flex; flex-direction: column; gap: 0; }
.term-bar { min-height: 50px; padding: 10px 14px; border: 1px solid var(--card-border); border-bottom: 0; border-radius: 12px 12px 0 0; background: var(--card); }
.term-title { display: flex; align-items: center; gap: 10px; }
.term-title h1 { font-size: 14px; margin: 0; }
.term-body { flex: 1; min-height: 0; max-height: none !important; padding: 16px 18px; border: 1px solid var(--card-border); border-radius: 0 0 12px 12px; background: #081116; color: #afd2d4; line-height: 1.75; }

/* Settings: fixed navigation rail with a comfortable reading column. */
.s-page-split { grid-template-columns: 176px minmax(0, 860px); gap: 20px; justify-content: center; }
.s-nav { position: sticky; top: 0; display: grid; align-content: start; gap: 4px; padding: 6px; border-radius: 11px; }
.s-nav button { width: 100%; text-align: left; padding: 9px 11px; }
.s-main { gap: 16px; }
.s-card { padding: 18px 20px; border-radius: 12px; }
.s-card-hd { margin-bottom: 14px; }
.s-row { min-height: 56px; padding: 12px 0; }
.s-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.s-field-block:last-child, .s-fields > label:last-child { grid-column: 1 / -1; }

@media (max-width: 1100px) {
  .stage { padding: 18px 18px 28px; }
  .px-tools { width: 100%; justify-content: flex-start; }
  .px-tools .proxies-search { flex: 1; min-width: 180px; }
  .pf-grid { grid-template-columns: 1fr; }
  .s-page-split { grid-template-columns: 1fr; }
  .s-nav { position: static; display: flex; overflow-x: auto; }
  .s-nav button { width: auto; white-space: nowrap; }
}
@media (max-width: 700px) {
  .stage { padding: 14px 12px 22px; }
  .px-header-card { position: static; }
  .px-tab { min-width: 150px; }
  .px-grid { grid-template-columns: 1fr; }
  .px-tools .proxies-search { flex-basis: 100%; }
  .s-fields { grid-template-columns: 1fr; }
  .s-field-block:last-child, .s-fields > label:last-child { grid-column: auto; }
  .unlock-grid.verge { grid-template-columns: 1fr; }
}
